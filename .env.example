# --- Retrieval / storage ---
DOCUSCALE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCUSCALE_STORAGE_PATH=./qdrant_data
DOCUSCALE_COLLECTION_NAME=docuscale
DOCUSCALE_CHUNK_SIZE=200
DOCUSCALE_CHUNK_OVERLAP=40
DOCUSCALE_RERANKER_MODEL=BAAI/bge-reranker-base
DOCUSCALE_CANDIDATE_K=20
DOCUSCALE_RRF_K=60
DOCUSCALE_FINAL_TOP_K=5

# --- HyDE query expansion (true/false) ---
DOCUSCALE_USE_HYDE=false

# --- LLM: any LiteLLM model string. Pick ONE provider block. ---
# Groq (hosted, free tier):
DOCUSCALE_LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-key
# Ollama (fully local, no key):
# DOCUSCALE_LLM_MODEL=ollama_chat/llama3.1
# DOCUSCALE_LLM_API_BASE=http://localhost:11434
# OpenAI:
# DOCUSCALE_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-key
# Or one provider-neutral key instead of the provider-specific variable:
# DOCUSCALE_LLM_API_KEY=your-key
